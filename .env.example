# Copy to .env and fill values. Restart `npm run dev` after changes.
# Production URLs live in `.env.production` (committed). Keep VITE_API_KEY out of git.

# Customer REST API (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# Customer WebSocket stream
VITE_WS_URL=ws://localhost:3001/v1/stream

# Full customer API key from admin create/rotate (wl_…)
VITE_API_KEY=
